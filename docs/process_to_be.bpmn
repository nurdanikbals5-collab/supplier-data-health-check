    <bpmn:textAnnotation id="TextAnnotation_10afp7m">
      <bpmn:text>Solves "manual check": 25 of 60 issues are fixed by rules</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0p4281f">
      <bpmn:text>Solves "e-mail ping-pong": only 25 of 60 issues need the supplier</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1g7urws">
      <bpmn:text>Solves "nobody knows how long": SLA dashboard shows waiting time</bpmn:text>
